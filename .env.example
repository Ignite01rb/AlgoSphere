MYSQL_DATABASE=algosphere
MYSQL_USER=algosphere
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
ALGOSPHERE_SECRET_KEY=replace-with-a-long-random-secret
# Render / hosted MySQL-compatible database:
# mysql://USER:PASSWORD@HOST:4000/algosphere?parseTime=true&charset=utf8mb4
ALGOSPHERE_DATABASE_URL=mysql://user:password@host:4000/algosphere?parseTime=true&charset=utf8mb4
# Enable TLS for hosted MySQL-compatible databases such as TiDB Cloud Starter.
ALGOSPHERE_DATABASE_SSL_CA_PATH=/etc/ssl/certs/ca-certificates.crt
ALGOSPHERE_DATABASE_SSL_VERIFY_CERT=true
ALGOSPHERE_DATABASE_SSL_VERIFY_IDENTITY=true
# Set this to your deployed frontend origin, for example:
# https://trie-quest.vercel.app
ALGOSPHERE_CORS_ORIGINS=https://trie-quest.vercel.app
# Render host plus local hosts used by health checks.
ALGOSPHERE_ALLOWED_HOSTS=algosphere-api.onrender.com,127.0.0.1,localhost
ALGOSPHERE_DATABASE_AUTO_MIGRATE=false
ALGOSPHERE_SEED_DEMO_DATA=false
ALGOSPHERE_AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
ALGOSPHERE_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
ALGOSPHERE_FRIEND_LOOKUP_RATE_LIMIT_MAX_ATTEMPTS=20
ALGOSPHERE_FRIEND_LOOKUP_RATE_LIMIT_WINDOW_SECONDS=60
ALGOSPHERE_ENABLE_ADMIN=false
ALGOSPHERE_ADMIN_EMAILS=
ALGOSPHERE_ADMIN_RATE_LIMIT_MAX_ATTEMPTS=5
ALGOSPHERE_ADMIN_RATE_LIMIT_WINDOW_SECONDS=300
ALGOSPHERE_ENABLE_DOCS=false
# TiDB Cloud Starter closes idle connections after 5 minutes; recycle pooled
# connections early to avoid stale pooled sessions on Render.
ALGOSPHERE_DATABASE_POOL_RECYCLE_SECONDS=300
ALGOSPHERE_SESSION_COOKIE_NAME=algosphere-admin-session
# Separate frontend deployments should use an absolute API URL.
VITE_API_BASE_URL=https://algosphere-api.onrender.com
