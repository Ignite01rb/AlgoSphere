ALGOSPHERE_ENVIRONMENT=development
ALGOSPHERE_SECRET_KEY=replace-this-with-a-long-random-secret
# Prisma DB URL (MySQL in prod, SQLite falls back to file:../algosphere.db if DATABASE_URL is not set)
DATABASE_URL=mysql://root:password@localhost:3306/algosphere
ALGOSPHERE_DATABASE_URL=sqlite:///./algosphere.db
ALGOSPHERE_DATABASE_AUTO_MIGRATE=false
ALGOSPHERE_DATABASE_POOL_SIZE=10
ALGOSPHERE_DATABASE_MAX_OVERFLOW=20
ALGOSPHERE_DATABASE_POOL_RECYCLE_SECONDS=1800
ALGOSPHERE_ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGOSPHERE_ENABLE_DOCS=false
ALGOSPHERE_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ALGOSPHERE_ALLOWED_HOSTS=localhost,127.0.0.1
ALGOSPHERE_SEED_DEMO_DATA=true
ALGOSPHERE_RUN_STARTUP_TASKS_ON_APP_START=true
ALGOSPHERE_AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
ALGOSPHERE_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
ALGOSPHERE_FRIEND_LOOKUP_RATE_LIMIT_MAX_ATTEMPTS=20
ALGOSPHERE_FRIEND_LOOKUP_RATE_LIMIT_WINDOW_SECONDS=60
ALGOSPHERE_ENABLE_ADMIN=false
ALGOSPHERE_ADMIN_EMAILS=
ALGOSPHERE_ADMIN_RATE_LIMIT_MAX_ATTEMPTS=5
ALGOSPHERE_ADMIN_RATE_LIMIT_WINDOW_SECONDS=300
ALGOSPHERE_FORWARDED_ALLOW_IPS=
ALGOSPHERE_SESSION_COOKIE_NAME=algosphere-admin-session
ALGOSPHERE_GOOGLE_CLIENT_ID=
ALGOSPHERE_GOOGLE_CLIENT_SECRET=
ALGOSPHERE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
PORT=8000
